# Vite build-time settings for the React web client.
# The site key is public; keep TURNSTILE_SECRET_KEY only in finpocket_server/.env.
VITE_TURNSTILE_SITE_KEY=replace_with_cloudflare_turnstile_site_key

# Flutter Android/iOS build-time define; pass this key with --dart-define.
# TURNSTILE_SITE_KEY=replace_with_the_same_cloudflare_turnstile_site_key
