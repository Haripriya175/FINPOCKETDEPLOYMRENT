<?xml version="1.0" encoding="utf-8"?>
<!--
  FinPocket Android network policy.

  The backend is served over plain HTTP on the developer machine
  (AppConfig.apiBaseUrl -> http://<loopback>:3001). Android 9+ blocks cleartext
  by default, which used to fail every /auth, /financial/overview and /accounts
  call and silently drop the app into offline demo data instead of real balances.

  Cleartext is therefore permitted ONLY to loopback aliases — the phone's own
  loopback (`127.0.0.1` / `localhost` / `[::1]`, used with `adb reverse
  tcp:3001 tcp:3001`) and the Android emulator's alias for the host machine
  (`10.0.2.2`). Every other destination, including api.finpocket.com, must use
  TLS — mirroring AppConfig, which refuses loopback URLs in production.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">[::1]</domain>
    </domain-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
