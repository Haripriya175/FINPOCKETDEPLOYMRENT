# ==============================================================================
# FinPocket Backend Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and provide appropriate credentials for your environment.
# NEVER commit real credentials, passwords, or API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server Settings
# ------------------------------------------------------------------------------
# Options: DEVELOPMENT | TEST | DEMO | STAGING | PRODUCTION
NODE_ENV=DEVELOPMENT
PORT=3001

# Application URLs and CORS
# In PRODUCTION, CORS_ORIGIN MUST NOT be wildcard '*' and must match your client domain.
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database Connectivity
# ------------------------------------------------------------------------------
# Local Development & Testing: SQLite file database
DATABASE_URL=sqlite:./finpocket.db

# Production / Staging: PostgreSQL 18 with TLS (sslmode=require)
# DATABASE_URL=postgresql://finpocket_app:YourSecureAppPassword123!@postgres.internal:5432/finpocket_prod?sslmode=require

# Database Migration / DDL Execution (Owner / Admin Connection)
# Required for running `npm run db:provision` and `npm run db:migrate`
# MIGRATIONS_DATABASE_URL=postgresql://finpocket_owner:YourOwnerPassword123!@postgres.internal:5432/finpocket_prod?sslmode=require

# ------------------------------------------------------------------------------
# 3. JWT & Cryptographic Session Security
# ------------------------------------------------------------------------------
# In PRODUCTION, JWT_SECRET must be at least 32 cryptographically random characters.
# Generate via: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_minimum_32_character_random_string_in_production
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ------------------------------------------------------------------------------
# 4. Email OTP Verification (Gmail SMTP via Nodemailer)
# ------------------------------------------------------------------------------
# Requires a Google Account with 2-Step Verification enabled and a 16-character App Password.
# Note: Regular Google account passwords will be rejected by Google's SMTP servers.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_finpocket_support@gmail.com
SMTP_APP_PASSWORD=abcd1234efgh5678
SMTP_FROM="FinPocket Security" <no-reply@finpocket.com>

# ------------------------------------------------------------------------------
# 5. Mobile SMS OTP Verification (Pluggable Indian SMS Providers)
# ------------------------------------------------------------------------------
# Provider Selection: fast2sms | msg91 | twilio | mock
SMS_PROVIDER=fast2sms

# Option A: Fast2SMS (Recommended for India - Quick OTP route, instant delivery)
# Sign up at https://www.fast2sms.com/ and obtain API Key from Dev API tab.
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_ROUTE=otp

# Option B: MSG91 (Enterprise India DLT-Compliant Provider)
# Requires TRAI DLT Principal Entity registration, approved Sender ID (Header), and Template ID.
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=your_msg91_auth_key_here
# MSG91_TEMPLATE_ID=your_dlt_approved_template_id_here

# Option C: Twilio (Requires Indian Regulatory Compliance / DLT approval for +91 delivery)
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# 6. Rate Limiting Controls
# ------------------------------------------------------------------------------
# Sliding window (milliseconds) and max requests allowed per IP / client
RATE_LIMIT_GENERAL_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=300

RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=15

RATE_LIMIT_PAYMENTS_WINDOW_MS=3600000
RATE_LIMIT_PAYMENTS_MAX=30

RATE_LIMIT_AI_WINDOW_MS=900000
RATE_LIMIT_AI_MAX=40

# ------------------------------------------------------------------------------
# 7. Payment Transaction Limits (INR)
# ------------------------------------------------------------------------------
PER_TXN_PAYMENT_LIMIT=25000.00
DAILY_PAYMENT_LIMIT=50000.00
MONTHLY_PAYMENT_LIMIT=200000.00

# ------------------------------------------------------------------------------
# 8. Demo, Mock & Sandbox Flags (MUST be false in PRODUCTION)
# ------------------------------------------------------------------------------
FINPOCKET_DEMO_MODE=false
FINPOCKET_ALLOW_MOCK_PROVIDER=false
FINPOCKET_DEMO_AUTO_LOGIN=false
ALLOW_MOCK_SSO=false

# ------------------------------------------------------------------------------
# 9. Account Aggregator (AA) Integration (Setu India)
# ------------------------------------------------------------------------------
AA_PROVIDER_ENABLED=false
AA_PROVIDER_NAME=SETU_AA_SANDBOX
SETU_ENVIRONMENT=SANDBOX
SETU_CLIENT_ID=your_setu_client_id
SETU_CLIENT_SECRET=your_setu_client_secret
SETU_PRODUCT_INSTANCE_ID=your_product_instance_id
SETU_API_BASE_URL=https://aa-sandbox.setu.co
SETU_AUTH_BASE_URL=https://uat.setu.co
SETU_REDIRECT_BASE_URL=http://localhost:3000/aa/redirect
SETU_CALLBACK_BASE_URL=http://localhost:3001/api/v1/aa/callback
SETU_WEBHOOK_SECRET=your_setu_webhook_hmac_secret

# ------------------------------------------------------------------------------
# 10. Logging & Diagnostics
# ------------------------------------------------------------------------------
# Options: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
